<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device transfer rules. Same reasoning as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="sermon_studio.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="bible-modules/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sermon_studio.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="bible-modules/" />
    </device-transfer>
</data-extraction-rules>
